  "questions": [
    {
      "id": 1,
      "text": "¿Te atrae reparar aparatos eléctricos o mecánicos?",
      "dimension": "R",
      "position": 1,
      "active": 1
    },
    {
      "id": 2,
      "text": "¿Prefieres las actividades prácticas que requieren esfuerzo físico o trabajo en exteriores?",
      "dimension": "R",
      "position": 2,
      "active": 1
    },
    {
      "id": 3,
      "text": "¿Te gustaría aprender a interpretar planos de construcción y estructuras arquitectónicas?",
      "dimension": "R",
      "position": 3,
      "active": 1
    },
    {
      "id": 4,
      "text": "¿Disfrutas operar maquinaria o herramientas con alta precisión?",
      "dimension": "R",
      "position": 4,
      "active": 1
    },
    {
      "id": 5,
      "text": "¿Te interesa conocer el funcionamiento interno de motores y circuitos?",
      "dimension": "R",
      "position": 5,
      "active": 1
    },
    {
      "id": 6,
      "text": "¿Te apasiona encontrar la solución a problemas lógicos o algoritmos complejos?",
      "dimension": "I",
      "position": 6,
      "active": 1
    },
    {
      "id": 7,
      "text": "¿Te gusta investigar el porqué de los fenómenos naturales o científicos?",
      "dimension": "I",
      "position": 7,
      "active": 1
    },
    {
      "id": 8,
      "text": "¿Disfrutas analizar datos y realizar experimentos en laboratorios?",
      "dimension": "I",
      "position": 8,
      "active": 1
    },
    {
      "id": 9,
      "text": "¿Te consideras curioso por comprender sistemas bioquímicos o biológicos?",
      "dimension": "I",
      "position": 9,
      "active": 1
    },
    {
      "id": 10,
      "text": "¿Te agrada resolver acertijos de programación o ecuaciones complejas?",
      "dimension": "I",
      "position": 10,
      "active": 1
    },
    {
      "id": 11,
      "text": "¿Prefieres crear algo nuevo desde cero en lugar de seguir un manual ya escrito?",
      "dimension": "A",
      "position": 11,
      "active": 1
    },
    {
      "id": 12,
      "text": "¿Te gustaría diseñar espacios habitables que sean tanto funcionales como bellos?",
      "dimension": "A",
      "position": 12,
      "active": 1
    },
    {
      "id": 13,
      "text": "¿Te expresas mejor mediante el dibujo, la música o el diseño gráfico?",
      "dimension": "A",
      "position": 13,
      "active": 1
    },
    {
      "id": 14,
      "text": "¿Disfrutas proponer soluciones creativas e innovadoras fuera de lo común?",
      "dimension": "A",
      "position": 14,
      "active": 1
    },
    {
      "id": 15,
      "text": "¿Te atrae el mundo visual, las tendencias estéticas y el arte contemporáneo?",
      "dimension": "A",
      "position": 15,
      "active": 1
    },
    {
      "id": 16,
      "text": "¿Disfrutas de asesorar o enseñar a otros sobre temas que tú dominas?",
      "dimension": "S",
      "position": 16,
      "active": 1
    },
    {
      "id": 17,
      "text": "¿Te sientes motivado al colaborar con comunidades para resolver problemas sociales?",
      "dimension": "S",
      "position": 17,
      "active": 1
    },
    {
      "id": 18,
      "text": "¿Prefieres trabajar directamente con personas guiándolas y apoyándolas?",
      "dimension": "S",
      "position": 18,
      "active": 1
    },
    {
      "id": 19,
      "text": "¿Tienes facilidad para escuchar y aconsejar a compañeros en situaciones difíciles?",
      "dimension": "S",
      "position": 19,
      "active": 1
    },
    {
      "id": 20,
      "text": "¿Te agrada organizar eventos para promover el bienestar de tu grupo?",
      "dimension": "S",
      "position": 20,
      "active": 1
    },
    {
      "id": 21,
      "text": "¿Disfrutas de las ventas, la negociación y el trato con proveedores o clientes?",
      "dimension": "E",
      "position": 21,
      "active": 1
    },
    {
      "id": 22,
      "text": "¿Te consideras una persona competitiva que busca optimizar recursos para ganar más?",
      "dimension": "E",
      "position": 22,
      "active": 1
    },
    {
      "id": 23,
      "text": "¿Te atrae la idea de liderar tu propia empresa o dirigir un equipo de trabajo?",
      "dimension": "E",
      "position": 23,
      "active": 1
    },
    {
      "id": 24,
      "text": "¿Tienes facilidad para convencer a otros sobre la viabilidad de tus ideas?",
      "dimension": "E",
      "position": 24,
      "active": 1
    },
    {
      "id": 25,
      "text": "¿Te motiva la toma de decisiones estratégicas bajo entornos de oportunidad?",
      "dimension": "E",
      "position": 25,
      "active": 1
    },
    {
      "id": 26,
      "text": "¿Te interesa el mundo de los impuestos, las auditorías y las leyes financieras?",
      "dimension": "C",
      "position": 26,
      "active": 1
    },
    {
      "id": 27,
      "text": "¿Disfrutas organizar archivos, bases de datos o inventarios de forma rigurosa?",
      "dimension": "C",
      "position": 27,
      "active": 1
    },
    {
      "id": 28,
      "text": "¿Prefieres contar con reglas y procedimientos claros antes de iniciar una tarea?",
      "dimension": "C",
      "position": 28,
      "active": 1
    },
    {
      "id": 29,
      "text": "¿Te aseguras de mantener tus finanzas y reportes de trabajo en estricto orden?",
      "dimension": "C",
      "position": 29,
      "active": 1
    },
    {
      "id": 30,
      "text": "¿Te apasiona la precisión de los registros contables y el control administrativo?",
      "dimension": "C",
      "position": 30,
      "active": 1
    }
  ],
