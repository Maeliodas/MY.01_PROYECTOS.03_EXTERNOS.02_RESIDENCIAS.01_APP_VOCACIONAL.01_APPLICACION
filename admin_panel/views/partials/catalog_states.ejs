<div class="crud-grid">
  <form class="crud-form card" data-type="states">
    <h3>Agregar estado</h3>
    <p class="form-help">La clave interna se genera automáticamente.</p>
    <input name="name" placeholder="Nombre" required>
    <input type="hidden" name="active" value="1">
    <button class="primary" type="submit">Guardar estado</button>
  </form>
  <div class="card table-card">
    <div class="table-tools"><input class="catalog-search" placeholder="Buscar estado…"></div>
    <div class="table-wrap"><table class="catalog-table">
      <thead><tr><th>Estado</th><th>Estatus</th><th></th></tr></thead>
      <tbody><% for(const r of catalogs.states){ %>
        <tr data-search="<%= r.name %>">
          <td><%= r.name %></td>
          <td><span class="status-label <%= r.active?'approved':'rejected' %>"><%= r.active?'Activo':'Inactivo' %></span></td>
          <td><button class="small-btn edit-record" data-type="states" data-id="<%= r.id %>" data-record='<%- JSON.stringify(r).replace(/'/g,"&#39;") %>'>Editar</button><button class="small-btn danger delete-record" data-type="states" data-id="<%= r.id %>">Baja</button></td>
        </tr>
      <% } %></tbody>
    </table></div>
  </div>
</div>
