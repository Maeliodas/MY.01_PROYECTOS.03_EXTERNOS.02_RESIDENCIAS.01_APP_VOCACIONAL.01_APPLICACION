<div class="crud-grid">
  <form class="crud-form card" data-type="municipalities">
    <h3>Agregar municipio</h3>
    <p class="form-help">Selecciona el estado; la clave interna se genera automáticamente.</p>
    <select name="state_id" required><option value="">Estado</option><% for(const s of catalogs.states){if(s.active){%><option value="<%= s.id %>"><%= s.name %></option><%}}%></select>
    <input name="name" placeholder="Nombre del municipio" required>
    <input type="hidden" name="active" value="1">
    <button class="primary" type="submit">Guardar municipio</button>
  </form>
  <div class="card table-card">
    <div class="table-tools"><input class="catalog-search" placeholder="Buscar municipio o estado…"></div>
    <div class="table-wrap"><table class="catalog-table">
      <thead><tr><th>Estado</th><th>Municipio</th><th>Estatus</th><th></th></tr></thead>
      <tbody><% for(const r of catalogs.municipalities){ %><tr data-search="<%= r.state_name %> <%= r.name %>">
        <td><%= r.state_name %></td><td><%= r.name %></td>
        <td><span class="status-label <%= r.active?'approved':'rejected' %>"><%= r.active?'Activo':'Inactivo' %></span></td>
        <td><button class="small-btn edit-record" data-type="municipalities" data-id="<%= r.id %>" data-record='<%- JSON.stringify(r).replace(/'/g,"&#39;") %>'>Editar</button><button class="small-btn danger delete-record" data-type="municipalities" data-id="<%= r.id %>">Baja</button></td>
      </tr><% } %></tbody>
    </table></div>
  </div>
</div>
