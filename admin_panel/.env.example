# Servidor HTTP local. En producción publicar detrás de Apache/Nginx con HTTPS.
PORT=8080

# MariaDB/MySQL institucional
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aevum_user
DB_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA
DB_NAME=aevum_iter

# Autenticación de la app móvil para POST /api/evaluations.
# Generar un valor largo y aleatorio. Debe coincidir con AEVUM_API_KEY al compilar Flutter.
API_INGEST_KEY=CAMBIAR_POR_TOKEN_LARGO_Y_ALEATORIO

# Acceso al panel web. Usar credenciales fuertes y HTTPS en producción.
ADMIN_USER=aevum_admin
ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_ADMIN_SEGURA
