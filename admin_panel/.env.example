# Servidor HTTP local. En producción publicar detrás de Apache/Nginx con HTTPS.
PORT=8080

# MariaDB/MySQL institucional
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_vocacional_user
DB_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA
DB_NAME=app_vocacional_ittux

# Autenticación de la app móvil para evaluaciones, catálogos y sugerencias.
# Generar un valor largo y aleatorio. Debe coincidir con APP_VOCACIONAL_API_KEY al compilar Flutter.
API_INGEST_KEY=CAMBIAR_POR_TOKEN_LARGO_Y_ALEATORIO

# Acceso al panel web. Usar credenciales fuertes y HTTPS en producción.
ADMIN_USER=app_vocacional_admin
ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_ADMIN_SEGURA

ADMIN_SESSION_SECRET=cambia-esta-clave-de-sesion-por-una-larga-y-aleatoria
